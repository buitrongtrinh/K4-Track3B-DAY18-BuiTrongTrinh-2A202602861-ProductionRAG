# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls) — cần ít nhất 1 key
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=

# Provider cho LLM (generation, enrichment, RAGAS judge): openai | deepseek
# Bỏ trống → openai nếu có OPENAI_API_KEY, ngược lại deepseek
LLM_PROVIDER=
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
